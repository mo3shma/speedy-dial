{
  "manifest_version": 3,
  "name": "Speedy Dial",
  "version": "1.5.0",
  "description": "A fast, beautiful speed dial new tab with history and widgets sidebars, one-click add and high-resolution icons.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "history", "topSites", "favicon", "contextMenus"],
  "host_permissions": ["https://t2.gstatic.com/*", "https://icon.horse/*", "https://www.google.com/s2/*", "https://api.iconify.design/*", "https://commons.wikimedia.org/*", "https://upload.wikimedia.org/*", "https://www.googleapis.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Add this site to Speedy Dial",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Add this site to Speedy Dial" } }
}

